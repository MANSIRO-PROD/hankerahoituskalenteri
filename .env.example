# ─────────────────────────────────────────────────────────────────────
# Kopioi tämä tiedosto nimelle .env ja täytä käyttämäsi kanavan tiedot.
#   cp .env.example .env
#
# .env EI kuulu versionhallintaan. Ympäristömuuttujat voittavat aina
# .env-tiedoston arvot, joten CI:ssä käytä salaisuuksia (secrets).
# ─────────────────────────────────────────────────────────────────────

# ── Discord (suositeltu) ─────────────────────────────────────────────
# Discord → Palvelimen asetukset → Integraatiot → Webhookit → Uusi webhook
# → Kopioi webhookin URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefg...

# ── Telegram (valinnainen) ───────────────────────────────────────────
# 1. Luo botti: kirjoita @BotFatherille /newbot → saat tokenin.
# 2. Lähetä botille yksi viesti, sitten hae chat_id osoitteesta
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# TELEGRAM_CHAT_ID=-1001234567890

# ── Slack (valinnainen) ──────────────────────────────────────────────
# Slack → Apps → Incoming Webhooks → Add to Slack → kopioi URL.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# ── Sähköposti / SMTP (valinnainen) ──────────────────────────────────
# Gmail: luo sovellussalasana (App password), älä käytä tilin salasanaa.
# Portti 587 = STARTTLS, portti 465 = SSL.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=oma.osoite@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=oma.osoite@gmail.com
# SMTP_TO=vastaanottaja@example.com,toinen@example.com
